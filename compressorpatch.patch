+    @staticmethod
+    def _strip_unrequested_headings(summary: str) -> str:
+        """Code-side backstop for the prompt's output contract: delete any ``##`` heading the
+        schema never asked for (observed drift: 'Next Steps', 'Session Summary', 'Current
+        Running Summary'), keeping the body text under it so nothing is lost — it just loses
+        its rogue heading. Canonical + code-appended headings are allow-listed, including
+        case/spacing variants the model sometimes emits."""
+        _ALLOWED = {
+            "historical task snapshot", "goal", "constraints & preferences", "completed actions",
+            "active state", "blocked", "key decisions", "errors & fixes", "resolved questions",
+            "relevant files", "critical context", "detailed session log (oldest first)", "session log",
+            "pruned skills", "context recovery", "anchor index (mechanically extracted, exact)",
+            "anchor index", "user messages (verbatim, newest first)", "user messages",
+        }
+        lines = summary.split("\n")
+        out: List[str] = []
+        stripped = 0
+        in_fence = False
+        for line in lines:
+            if line.lstrip().startswith("```"):
+                # Fenced block: the contract forbids fences, but a model that emits one
+                # must not have its unindented '# comment' snippet lines eaten as headings.
+                in_fence = not in_fence
+            elif not in_fence:
+                m = re.match(r"^(#{1,6})\s+(.*?)\s*$", line)
+                if m:
+                    # Loop-normalize formatting habits (audit v3.3): bold AND colon
+                    # together ('## **Completed Actions**:') survived single-pass
+                    # strip('*_')+rstrip('.:') and false-positively got stripped.
+                    raw_title = m.group(2).strip()
+                    t = raw_title.lower()
+                    while True:
+                        t2 = t.strip("*_.: \t ").replace("**", "").replace("__", "")
+                        if t2 == t:
+                            break
+                        t = t2
+                    if t not in _ALLOWED:
+                        stripped += 1
+                        # Drop the heading, keep the body that follows.
+                        continue
+                    # Master fix (audit v3.3): re-emit surviving headings canonically as
+                    # '## Title', so level drift (#/###), bold wrapping, and trailing
+                    # colon can never evade _cap_summary_handoff / _hkey downstream.
+                    # Casing and parenthetical suffixes preserved verbatim.
+                    title = raw_title
+                    while title != (title2 := title.strip().rstrip(".:").strip("*").rstrip(".:")):
+                        title = title2
+                    out.append("## " + title)
+                    continue
+            out.append(line)
+        if stripped:
+            logger.info("Summary output contract: stripped %d unrequested heading(s)", stripped)
+        return "\n".join(out)
+
