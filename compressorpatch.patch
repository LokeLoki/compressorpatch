+    def _ground_session_facts(self, summary: str) -> str:
+        """Stamp exact live per-session counters into Active State, replacing any stale copy.
+
+        The summarizer only ever sees the eviction window plus its own previous handoff; the usage
+        row lives in the protected tail, never in the fold's input — so inherited counters
+        ("5.3M tokens, 31.3h") drift forward silently across folds, un-quarantinable because nothing
+        in the fold's input contradicts them. Deterministic post-generation write closes that loop.
+        Active State is never evicted by the cap, so the line survives. Best-effort: any failure
+        returns the summary untouched.
+        """
+        try:
+            db = getattr(self, "_session_db", None)
+            sid = getattr(self, "_session_id", "") or ""
+            if db is None or not sid:
+                return summary
+            row = db.get_session(sid) if hasattr(db, "get_session") else None
+            if not isinstance(row, dict):
+                return summary
+            inp = int(row.get("input_tokens") or 0)
+            out = int(row.get("output_tokens") or 0)
+            mc = int(db.message_count(sid)) if hasattr(db, "message_count") else int(row.get("message_count") or 0)
+            started = float(row.get("started_at") or 0.0)
+            hours = f"{(time.time() - started) / 3600.0:.1f}h" if started > 0 else "unknown h"
+            line = (
+                f"- ⚙ {self._LIVE_COUNTERS_MARKER}): {inp + out:,} tokens "
+                f"({inp:,} in / {out:,} out), {mc:,} messages, {hours} since session start. "
+                "Machine-stamped from the session DB at fold time — this line is current truth; "
+                "never replace it with numbers copied from earlier handoffs."
+            )
+            # Idempotent: drop any previously stamped line (across iterative updates), then insert fresh.
+            summary = re.sub(rf"^\s*[-*]?\s*⚙?\s*{re.escape(self._LIVE_COUNTERS_MARKER)}.*$\n?", "", summary, flags=re.M)
+            m = re.search(r"^##\s+Active State:?\s*$", summary, flags=re.M)
+            if m:
+                pos = m.end()
+                return summary[:pos] + "\n" + line + summary[pos:]
+            return summary + f"\n\n## Active State\n{line}\n"
+        except Exception as exc:
+            logger.debug("session-fact grounding failed: %s", exc)
+            return summary
+
+    def _cap_summary_handoff(self, summary: str, ceiling_tokens: int | None = None) -> str:
+        """Deterministic hard cap for the assembled handoff so iterative updates can't let the
+        index outgrow its usefulness (observed: ~4K → ~19K chars over 13 generations, no ceiling).
+
+        Same pattern as _dedup_summary_sections: exact ``##`` headings, conservative line-level
+        edits, and floors so a pathological section is never mass-deleted. When the handoff
+        exceeds the cap, evict the OLDEST bullet entries of the low-priority record sections,
+        lowest value first: Detailed Session Log (keep newest 6) → Completed Actions (keep
+        newest 10) → Anchor Index (keep newest 12). If still over ceiling, v3.4.8 secondary
+        tier (audit): Resolved Questions (keep 5) → Relevant Files (keep 10) → Errors &
+        Fixes (keep 6). Never fully evicted: the state sections
+        (Historical Task Snapshot, Active State, Blocked), the verbatim User Messages block,
+        Pruned Skills, and the Context Recovery footer. Each eviction leaves a one-line note
+        pointing at session_search, so nothing is lost silently.
+        """
+        ceiling = (int(ceiling_tokens) if ceiling_tokens else
+                   min(int(self.context_length * _HANDOFF_CEILING_CTX_SHARE), _HANDOFF_CEILING_TOKENS))
+        ceiling_chars = int(ceiling * 4)  # ~4 chars/token, same roughness as the estimator
+        if not ceiling_chars or len(summary) <= ceiling_chars:
+            return summary
+
+        def _find_section(heading_prefix: str):
+            """(start, end) char span of the first ``##`` section with this prefix, or None.
+            The span runs from the heading line to the next ``## `` heading (or end of text),
+            so only the targeted section is ever spliced — every other byte is preserved."""
+            start = 0
+            while True:
+                at = summary.find("## ", start)
+                if at == -1:
+                    return None
+                line_end = summary.find("\n", at)
+                if line_end == -1:
+                    line_end = len(summary)
+                heading_line = summary[at:line_end]
+                if heading_line.startswith(heading_prefix):
+                    nxt = summary.find("\n## ", line_end)
+                    end = len(summary) if nxt == -1 else nxt + 1
+                    return at, end
+                start = line_end + 1
+
+        def _evict_oldest(heading_prefix: str, keep: int) -> bool:
+            nonlocal summary
+            span = _find_section(heading_prefix)
+            if span is None:
+                return False
+            start, end = span
+            section = summary[start:end]
+            lines = section.split("\n")
+            # Entries: top-level "- " / "* " bullets, or "N. " numbered items — not
+            # nested, and never inside a fenced block (audit v3.3: markdown bullets
+            # inside a code snippet are content, not eviction candidates).
+            fence_flags: List[bool] = []
+            in_f = False
+            for l in lines:
+                if l.lstrip().startswith("```"):
+                    in_f = not in_f
+                fence_flags.append(in_f)
+
+            def _is_entry(l: str) -> bool:
+                if l.startswith("- ") or l.startswith("* "):
+                    return True
+                m = re.match(r"^(\d+)\.\s", l)
+                return bool(m) and not l.startswith((" ", "\t"))
+            entry_idx = [i for i, l in enumerate(lines) if _is_entry(l) and not fence_flags[i]]
+            if len(entry_idx) <= keep:
+                return False
+            n_drop = len(entry_idx) - keep
+            # Span-based eviction (audit v3.1): an entry spans from its line up to the
+            # NEXT entry line, so indented sub-bullets and continuation lines drop with
+            # their parent instead of orphaning under the eviction note.
+            drop_start, drop_end = entry_idx[0], entry_idx[n_drop]
+            # Never cut a fenced block in half (audit v3.3): a drop span carrying an
+            # odd fence count extends through the next delimiter, keeping the kept
+            # body's fences balanced for every downstream consumer.
+            if sum(1 for i in range(drop_start, drop_end) if lines[i].lstrip().startswith("```")) % 2:
+                closer = next((i for i in range(drop_end, len(lines)) if lines[i].lstrip().startswith("```")), None)
+                if closer is not None:
+                    drop_end = closer + 1
+            new_lines: list[str] = []
+            for i, l in enumerate(lines):
+                if drop_start <= i < drop_end:
+                    if i == drop_start:
+                        new_lines.append(f"  (…{n_drop} older entries evicted to fit the handoff budget — recover via session_search…)")
+                else:
+                    new_lines.append(l)
+            new_body = "\n".join(new_lines)
+            if len(new_body) >= len(section):  # floor: eviction must actually shrink
+                return False
+            summary = summary[:start] + new_body + summary[end:]
+            return True
+
+        evicted = 0
+        for prefix, keep in (
+            ("## Detailed Session Log", 6),
+            ("## Completed Actions", 10),
+            ("## Anchor Index", 12),
+        ):
+            if len(summary) <= ceiling_chars:
+                break
+            if _evict_oldest(prefix, keep):
+                evicted += 1
+        # v3.4.8 secondary tier (audit): the primary trio can finish all three passes
+        # while the handoff is still over ceiling — models dump long tracebacks and
+        # decision prose into the middle sections, which used to sail through untouched.
+        # Value order: lowest signal first. Same eviction machinery, same floors.
+        for prefix, keep in (
+            ("## Resolved Questions", 5),
+            ("## Relevant Files", 10),
+            ("## Errors & Fixes", 6),
+        ):
+            if len(summary) <= ceiling_chars:
+                break
+            if _evict_oldest(prefix, keep):
+                evicted += 1
+        if evicted and not self.quiet_mode:
+            logger.info("Handoff cap: evicted %d low-priority section(s) to fit the %d-token ceiling", evicted, ceiling)
+        return summary
+
