+    @staticmethod
+    def _dedup_summary_sections(summary: str) -> str:
+        """Code-side backstop for the ONE HOME PER FACT output rule. Two observed
+        small-summarizer failure modes: (a) NESTING — an iterative update pastes the
+        previous summary's heading ladder into the new one, so every ``##`` heading
+        (and its body) appears twice; (b) CROSS-SECTION ECHO — the same bug-fix
+        sentence is repeated verbatim under Errors & Fixes, Key Decisions, and
+        Resolved Questions. Pass 1 keeps only the LAST copy of each duplicated
+        ``##`` section (the merge rewrite, not the nested older paste) and drops
+        earlier copies with their bodies. Pass 2 drops all but the LAST verbatim
+        duplicate line ≥60 chars — last-wins so lean-mode's deterministic verbatim
+        User Messages / Anchor Index sections, appended after the LLM body, always
+        survive while prose echoes fall away. Deliberately conservative: exact
+        whole-line matches only, a length floor, and hard caps so a pathological
+        output can never be mass-deleted.
+        """
+        lines = summary.split("\n")
+
+        # Fence tracking (audit v3.1): '##' inside a code block is body text, not a
+        # schema heading. fence_flags[i] is True for fence delimiters and everything
+        # between them; an unbalanced fence makes Pass 1 inert (conservative: never drop).
+        in_fence = False
+        fence_flags: List[bool] = []
+        for line in lines:
+            if line.lstrip().startswith("```"):
+                in_fence = not in_fence
+            fence_flags.append(in_fence)
+
+        def _hkey(line: str) -> "str | None":
+            # Normalization aligned with _strip_unrequested_headings (audit v3.2) so
+            # colon/bold variants ('## Active State:', '## **Active State**') dedup
+            # against their plain form instead of nesting past Pass 1.
+            m = re.match(r"^##\s+(.*?)\s*$", line)
+            return m.group(1).strip().strip("*_").strip().lower().rstrip(".:") if m else None
+
+        # Pass 1: collapse duplicated '##' sections — keep the last occurrence.
+        counts: Dict[str, int] = {}
+        for i, line in enumerate(lines):
+            if fence_flags[i]:
+                continue
+            k = _hkey(line)
+            if k is not None:
+                counts[k] = counts.get(k, 0) + 1
+        dup_heads = {k for k, c in counts.items() if c > 1}
+        remaining = dict(counts)
+        out: List[str] = []
+        drop_body_until_next_heading = False
+        collapsed = 0
+        for i, line in enumerate(lines):
+            k = None if fence_flags[i] else _hkey(line)
+            if k is not None:
+                if k in dup_heads:
+                    remaining[k] -= 1
+                    if remaining[k] > 0:  # an earlier copy of a repeated section
+                        drop_body_until_next_heading = True
+                        collapsed += 1
+                        continue
+                drop_body_until_next_heading = False
+            elif drop_body_until_next_heading:
+                continue
+            out.append(line)
+        if collapsed:
+            logger.info("Summary output contract: collapsed %d duplicated section copy(ies)", collapsed)
+
+        # Pass 2: drop all but the last verbatim duplicate line (≥60 chars).
+        def _norm(s: str) -> str:
+            return re.sub(r"\s+", " ", s).strip()
+
+        normed = [_norm(l) for l in out]
+        # Fence flags recomputed on `out` (audit v3.3): Pass 1 spliced lines, so flags
+        # built from `lines` no longer align. Fenced lines are neither counted nor
+        # dropped: a line appearing once in prose and once in code keeps both copies.
+        out_in_fence = False
+        out_fence: List[bool] = []
+        for l in out:
+            if l.lstrip().startswith("```"):
+                out_in_fence = not out_in_fence
+            out_fence.append(out_in_fence)
+        seen_counts: Dict[str, int] = {}
+        for i, n in enumerate(normed):
+            if len(n) >= 60 and not out_fence[i]:
+                seen_counts[n] = seen_counts.get(n, 0) + 1
+        remaining_lines = {n: c for n, c in seen_counts.items() if c > 1}
+        drop_idx: set = set()
+        for i, n in enumerate(normed):
+            if out_fence[i]:
+                continue
+            c = remaining_lines.get(n)
+            if c is not None and c > 1:
+                remaining_lines[n] = c - 1
+                drop_idx.add(i)
+        if len(drop_idx) > 30:  # safety cap: over-dedup means something is wrong
+            logger.warning("Summary dedup: hit 30-line cap, truncating dedup set")
+            drop_idx = set(sorted(drop_idx)[:30])
+        if drop_idx:
+            logger.info("Summary output contract: removed %d cross-section duplicate line(s)", len(drop_idx))
+            out = [l for i, l in enumerate(out) if i not in drop_idx]
+        return "\n".join(out)
+
     @classmethod
